{
  "manifest_version": 3,
  "name": "MemoryBread 浏览器集成",
  "version": "0.2.1",
  "description": "记忆面包浏览器集成插件，自动控制浏览器捕获记忆最新数据",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage", "alarms", "debugger"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {
    "default_title": "MemoryBread 浏览器集成",
    "default_popup": "popup.html"
  }
}
