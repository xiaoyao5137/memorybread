{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorybread.local/contracts/creation-tools.v1.schema.json",
  "title": "MemoryBread Creation Tools v1",
  "type": "object",
  "required": ["enabled_tools"],
  "properties": {
    "enabled_tools": {
      "type": "array",
      "description": "本次创作允许 Agent 调用的 Tool ID。服务端必须提供 internet_search、memory_search、data_search 与 webpage_scrape 能力；是否实际调用由 Harness 根据意图和 Tool 反馈动态决定。",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "internet_search",
        "memory_search",
        "data_search",
        "webpage_scrape"
      ]
    },
    "max_references": {
      "type": "integer",
      "description": "memory_search 单次最多召回的记忆资料条数。旧客户端不传时默认 10 条。",
      "minimum": 1,
      "maximum": 30,
      "default": 10
    },
    "data_search_limit": {
      "type": "integer",
      "description": "data_search 单次最多召回的数据来源条数。旧客户端不传时默认 30 条。",
      "minimum": 1,
      "maximum": 50,
      "default": 30
    }
  },
  "$defs": {
    "known_tool_id": {
      "type": "string",
      "enum": [
        "internet_search",
        "memory_search",
        "data_search",
        "webpage_scrape",
        "plantuml_diagram",
        "github_search"
      ]
    },
    "tool_event": {
      "type": "object",
      "required": [
        "schema_version",
        "type",
        "status",
        "actor",
        "summary"
      ],
      "properties": {
        "schema_version": {
          "const": "creation.agent.v1"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool.started",
            "tool.completed",
            "tool.failed"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed"
          ]
        },
        "actor": {
          "type": "object",
          "required": [
            "kind",
            "id",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "tool"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "summary": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "result_count": {
              "type": "integer",
              "minimum": 0
            },
            "result_limit": {
              "type": "integer",
              "minimum": 1
            },
            "error_code": {
              "type": "string",
              "enum": [
                "TOOL_NOT_INSTALLED",
                "TOOL_DISABLED",
                "TOOL_UNAVAILABLE",
                "TOOL_EXECUTION_FAILED",
                "DATA_SEARCH_UNAVAILABLE",
                "DATA_SOURCE_NOT_FOUND",
                "DATA_SOURCE_URL_MISSING",
                "BROWSER_ATTACH_UNAVAILABLE",
                "BROWSER_SCRIPTING_DISABLED",
                "FOCUS_POLICY_BLOCKED",
                "SCRAPE_AUTH_REQUIRED",
                "SCRAPE_EMPTY",
                "SCRAPE_FAILED"
              ]
            }
          }
        }
      }
    },
    "quality_issue": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "agent_id",
        "summary",
        "evidence",
        "required_capabilities"
      ],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["hard", "soft"]},
        "agent_id": {
          "type": "string",
          "enum": [
            "document_writer_agent",
            "detail_polish_agent",
            "table_polish_agent",
            "image_polish_agent",
            "anti_ai_style_agent",
            "typography_polish_agent"
          ]
        },
        "summary": {"type": "string"},
        "evidence": {"type": ["object", "array"]},
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "data_search",
              "data_analysis_agent",
              "plantuml_diagram",
              "skill:voice_style",
              "skill:structure",
              "skill:table_style",
              "skill:typography_style",
              "skill:image_style"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "harness_decision_event": {
      "type": "object",
      "required": ["schema_version", "type", "status", "actor", "summary", "data"],
      "properties": {
        "schema_version": {"const": "creation.agent.v1"},
        "type": {"const": "harness.decision"},
        "status": {"const": "completed"},
        "actor": {
          "type": "object",
          "required": ["kind", "id", "name"],
          "properties": {
            "kind": {"const": "agent"},
            "id": {"const": "creation_main_agent"},
            "name": {"type": "string"}
          }
        },
        "summary": {"type": "string"},
        "data": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "trigger",
                "trigger_status",
                "reason_code",
                "result_count",
                "refreshable_count",
                "analyzable_count",
                "scheduled"
              ],
              "properties": {
                "trigger": {"type": "string", "enum": ["data_search", "webpage_scrape"]},
                "trigger_status": {"type": "string", "enum": ["completed", "failed"]},
                "reason_code": {"type": "string"},
                "result_count": {"type": "integer", "minimum": 0},
                "refreshable_count": {"type": "integer", "minimum": 0},
                "analyzable_count": {"type": "integer", "minimum": 0},
                "scheduled": {
                  "type": "array",
                  "items": {"type": "string", "enum": ["webpage_scrape", "data_analysis_agent"]},
                  "uniqueItems": true
                },
                "error_code": {"type": ["string", "null"]}
              }
            },
            {
              "type": "object",
              "required": [
                "trigger",
                "trigger_status",
                "reason_code",
                "quality_cycle",
                "issue_count",
                "issue_codes",
                "scheduled",
                "activated_skills"
              ],
              "properties": {
                "trigger": {"const": "quality_review_agent"},
                "trigger_status": {"type": "string", "enum": ["completed", "failed"]},
                "reason_code": {
                  "type": "string",
                  "enum": [
                    "quality_review_failed",
                    "quality_gate_passed",
                    "quality_issues_detected",
                    "quality_issues_deferred",
                    "quality_cycle_budget_exhausted",
                    "hard_failure_retry_exhausted"
                  ]
                },
                "quality_cycle": {"type": "integer", "minimum": 0, "maximum": 3},
                "issue_count": {"type": "integer", "minimum": 0},
                "issue_codes": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                },
                "scheduled": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "data_search",
                      "data_analysis_agent",
                      "plantuml_diagram",
                      "document_writer_agent",
                      "detail_polish_agent",
                      "table_polish_agent",
                      "image_polish_agent",
                      "anti_ai_style_agent",
                      "typography_polish_agent",
                      "quality_review_agent"
                    ]
                  }
                },
                "activated_skills": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true,
                  "maxItems": 2
                },
                "error_code": {"type": ["string", "null"]}
              }
            }
          ]
        }
      }
    },
    "thinking_event": {
      "type": "object",
      "description": "深度思考事件对：thinking.started 在意图理解、链路决策、内容生成或反馈规划开始时发出，thinking.completed 在该阶段推理结束后发出并携带面向用户的推理摘要。内容生成（generation）包裹文档撰写/润色等大模型内容调用。展示层用两者 timestamp 差计算思考时长；旧记录可能没有该事件，客户端必须向后兼容。",
      "required": ["schema_version", "type", "status", "actor", "summary", "data"],
      "properties": {
        "schema_version": {"const": "creation.agent.v1"},
        "type": {"type": "string", "enum": ["thinking.started", "thinking.completed"]},
        "status": {"type": "string", "enum": ["running", "completed"]},
        "actor": {
          "type": "object",
          "required": ["kind", "id", "name"],
          "properties": {
            "kind": {"const": "agent"},
            "id": {"const": "creation_main_agent"},
            "name": {"type": "string"}
          }
        },
        "summary": {"type": "string"},
        "data": {
          "type": "object",
          "required": ["stage"],
          "properties": {
            "stage": {
              "type": "string",
              "enum": ["intent", "routing", "generation", "planning"]
            },
            "reasoning": {
              "type": "string",
              "maxLength": 400,
              "description": "仅 thinking.completed 携带；该阶段面向用户的推理摘要"
            }
          }
        }
      }
    },
    "phase_event": {
      "type": "object",
      "description": "顶层执行阶段事件对：phase.started 在进入一个宏观阶段时发出，phase.completed 在该阶段结束时发出。Skill 流程里同一个 Skill 步骤的 Tool/Agent/Writer 归入同一阶段（phase_kind=skill_step）；无 Skill 时每个计划步骤自成一个宏观阶段（phase_kind=plan_step）。展示层据此把执行过程分成“阶段 → 思考/动作 → 明细”三层；旧记录可能没有该事件，客户端必须向后兼容。",
      "required": ["schema_version", "type", "status", "actor", "summary", "data"],
      "properties": {
        "schema_version": {"const": "creation.agent.v1"},
        "type": {"type": "string", "enum": ["phase.started", "phase.completed"]},
        "status": {"type": "string", "enum": ["running", "completed"]},
        "actor": {
          "type": "object",
          "required": ["kind", "id", "name"],
          "properties": {
            "kind": {"const": "agent"},
            "id": {"const": "creation_main_agent"},
            "name": {"type": "string"}
          }
        },
        "summary": {
          "type": "string",
          "description": "阶段标题，如 Skill 步骤标题或宏观计划步骤名"
        },
        "data": {
          "type": "object",
          "required": ["phase_id", "phase_title", "phase_kind"],
          "properties": {
            "phase_id": {"type": "string"},
            "phase_title": {"type": "string"},
            "phase_kind": {
              "type": "string",
              "enum": ["skill_step", "plan_step"]
            }
          }
        }
      }
    }
  }
}
