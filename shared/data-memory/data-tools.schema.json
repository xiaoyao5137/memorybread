{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorybread.local/contracts/data-tools.v1.schema.json",
  "title": "MemoryBread Data Tools v1",
  "type": "object",
  "$defs": {
    "tool_id": {
      "type": "string",
      "enum": ["data_search", "webpage_scrape"]
    },
    "source_kind": {
      "type": "string",
      "enum": ["report_url", "work_memory"]
    },
    "freshness_class": {
      "type": "string",
      "enum": ["live", "fresh", "aging", "stale", "missing"]
    },
    "timeline_data_fact_v3": {
      "type": "object",
      "required": ["title", "subject", "action", "target_context", "dimension", "metric", "value", "unit", "statement", "evidence_quote", "confidence"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "不含数值且完整说明具体对象、动作或目标场景与指标；不得使用用户、任务、生成参数等泛称"
        },
        "subject": {"type": "string", "minLength": 1, "maxLength": 80},
        "action": {"type": "string"},
        "target_context": {"type": "string"},
        "dimension": {"type": "string"},
        "metric": {"type": "string", "minLength": 1, "maxLength": 60},
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "原始数值、范围或复合数值；16分31秒等复合时长必须整体保留"
        },
        "unit": {
          "type": "string",
          "maxLength": 24,
          "description": "单一原始单位；复合时长的单位保留在 value 中且本字段为空"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "仅描述当前原子事实，必须包含当前事实的语义锚点与指标值；不得复用同批其他事实的汇总句"
        },
        "evidence_quote": {"type": "string", "minLength": 1, "maxLength": 500},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
      },
      "additionalProperties": false
    },
    "data_memory_v15": {
      "type": "object",
      "required": ["extraction_version", "semantic_origin", "title", "summary", "semantic_subject", "semantic_identity", "metric_rows"],
      "properties": {
        "extraction_version": {"const": "data-memory.v15"},
        "content_render_version": {
          "const": "fact-specific.v1",
          "description": "存在时表示快照正文由当前事实的结构化指标与逐字证据生成，不直接信任模型汇总句"
        },
        "semantic_origin": {"type": "string", "enum": ["model_structured_fact", "legacy_parser"]},
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "不含具体数值、能够说明数据对象与主题的语义标题"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "包含主题、对象/范围、关键指标值及可用结论的概述"
        },
        "semantic_subject": {
          "type": "string",
          "description": "数据指标所属的对象、业务范围或分类母体；指标自身已完整命名时可为空字符串"
        },
        "semantic_identity": {
          "type": "string",
          "minLength": 1,
          "description": "排除具体数值和采集时间后的稳定数据语义身份，与稳定页面/文档范围共同用于跨时间线判重"
        },
        "metric_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["dimension", "metric", "value", "note"],
            "properties": {
              "dimension": {"type": "string"},
              "metric": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "note": {"type": "string"},
              "statement": {"type": "string"},
              "observed_at": {"type": ["integer", "null"]}
            }
          }
        },
        "metric_statements": {"type": "array"}
      }
    },
    "creation_evidence": {
      "type": "object",
      "required": [
        "id",
        "run_id",
        "session_id",
        "source_url",
        "page_title",
        "captured_at",
        "image_url",
        "mime_type",
        "width",
        "height",
        "content_hash",
        "screenshot_source",
        "validation_status"
      ],
      "properties": {
        "id": {"type": "string"},
        "run_id": {"type": "string"},
        "session_id": {"type": "string"},
        "history_id": {"type": ["integer", "null"]},
        "source_id": {"type": ["integer", "null"]},
        "data_snapshot_id": {"type": ["integer", "null"]},
        "source_url": {"type": "string"},
        "page_title": {"type": "string"},
        "captured_at": {"type": "integer", "minimum": 0},
        "image_url": {"type": "string"},
        "mime_type": {"const": "image/jpeg"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string"},
        "screenshot_source": {"const": "browser_window"},
        "validation_status": {"type": "string", "enum": ["pending", "verified", "rejected"]},
        "validation": {"type": "object"}
      }
    },
    "data_search_request": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 12000},
        "need_fresh": {"type": "boolean", "default": false},
        "as_of_ms": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1, "maximum": 50, "default": 30}
      },
      "additionalProperties": false
    },
    "data_result": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "source_kind",
        "access_mode",
        "refresh_policy",
        "freshness_class",
        "freshness_score",
        "identity_relevance_score",
        "relevance_score",
        "final_score",
        "refresh_required",
        "can_use"
      ],
      "properties": {
        "source_id": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "source_kind": {"$ref": "#/$defs/source_kind"},
        "source_url": {"type": ["string", "null"]},
        "access_mode": {"type": "string"},
        "refresh_policy": {"type": "string"},
        "observed_at": {"type": ["integer", "null"]},
        "collected_at": {"type": ["integer", "null"]},
        "freshness_class": {"$ref": "#/$defs/freshness_class"},
        "freshness_score": {"type": "number", "minimum": 0, "maximum": 1},
        "identity_relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "final_score": {"type": "number", "minimum": 0, "maximum": 1},
        "refresh_required": {"type": "boolean"},
        "can_use": {"type": "boolean"},
        "content_excerpt": {"type": ["string", "null"]},
        "structured_data": {
          "type": ["object", "array", "null"],
          "description": "工作数据使用 data_memory_v15；报表结果可在同一对象中附带原始表格字段"
        },
        "provenance": {"type": ["object", "null"]},
        "history": {
          "type": "array",
          "description": "同一数据源按自然周阶段保留的历史快照，最新阶段在前，用于趋势和同期比较",
          "items": {
            "type": "object",
            "required": ["observed_at", "content_text", "structured_data", "period_granularity", "period_key"],
            "properties": {
              "observed_at": {"type": ["integer", "null"]},
              "collected_at": {"type": "integer"},
              "content_text": {"type": "string"},
              "structured_data": {"type": ["object", "array"]},
              "period_granularity": {"const": "week"},
              "period_key": {"type": "string"},
              "period_start_at": {"type": ["integer", "null"]},
              "period_end_at": {"type": ["integer", "null"]},
              "provenance": {"type": "object"}
            }
          }
        }
      }
    },
    "data_search_response": {
      "type": "object",
      "required": ["schema_version", "query", "results"],
      "properties": {
        "schema_version": {"const": "memorybread.data-search.v1"},
        "query": {"type": "string"},
        "results": {"type": "array", "items": {"$ref": "#/$defs/data_result"}}
      }
    },
    "webpage_scrape_request": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "integer", "minimum": 1},
        "mode": {"type": "string", "enum": ["auto", "browser", "http"], "default": "auto"},
        "browser_preference": {
          "type": "string",
          "enum": ["auto", "chrome", "chrome_canary", "edge", "brave", "chromium", "vivaldi", "safari"],
          "default": "auto"
        },
        "capture_evidence": {"type": "boolean", "default": false},
        "retain_screenshot": {
          "type": "boolean",
          "default": true,
          "description": "是否把本轮浏览器截图保留为创作文档证据"
        },
        "run_id": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "preview_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "本轮后台浏览器缩略预览与最终证据共用的本机标识"
        },
        "objective": {
          "type": ["string", "null"],
          "maxLength": 12000,
          "description": "当前 Skill 步骤的原始采集目标；用于选择指定 Tab 与页面筛选器"
        },
        "requested_metrics": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "当前步骤希望展示的指标名；逐项校验并返回已取得部分，不因其他项缺失拒绝整条证据"
        },
        "required_metrics": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "deprecated": true,
          "description": "旧客户端兼容别名，按 requested_metrics 的部分成功语义处理"
        },
        "expected_period_start": {
          "type": ["string", "null"],
          "format": "date"
        },
        "expected_period_end": {
          "type": ["string", "null"],
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "webpage_scrape_response": {
      "type": "object",
      "required": ["schema_version", "source_id", "collector", "collected_at", "content_text"],
      "properties": {
        "schema_version": {"const": "memorybread.webpage-scrape.v1"},
        "source_id": {"type": "integer", "minimum": 1},
        "collector": {"type": "string", "enum": ["browser_attach", "chrome_attach", "direct_http"]},
        "browser": {
          "type": ["string", "null"],
          "enum": ["chrome", "chrome_canary", "edge", "brave", "chromium", "vivaldi", "safari", null]
        },
        "interaction_mode": {"type": "string", "enum": ["background_tab", "background_browser_window", "temporary_foreground_tab", "none"]},
        "collected_at": {"type": "integer", "minimum": 0},
        "title": {"type": "string"},
        "url": {"type": "string"},
        "content_text": {"type": "string"},
        "structured_data": {
          "type": ["object", "array", "null"],
          "description": "采集成功后追加 data-memory.v15 的 title、summary、semantic_identity 与 metric_rows"
        },
        "content_hash": {"type": "string"},
        "evidence": {
          "anyOf": [
            {"$ref": "#/$defs/creation_evidence"},
            {"type": "null"}
          ]
        }
      }
    },
    "creation_evidence_validation_request": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["verified", "rejected"]},
        "validation": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
