+    system_checks = []
+    for required in SOURCE_SCOPE_CHECKS:
+        check_id = required["id"]
+        while check_id in seen:
+            check_id += "_"
+        seen.add(check_id)
+        system_checks.append({"id": check_id, "criterion": required["criterion"]})
+    result["acceptance"] = system_checks + result["acceptance"]
+    return result
