+@pytest.mark.parametrize("change", [
+    {"meaning": ""}, {"kind": "unknown"}, {"basis": "unknown"}, {"extra": "unknown"},
+])
+def test_candidate_typography_does_not_bypass_other_audit_contract_fields(change):
